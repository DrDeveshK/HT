# Copy to .env and fill in. Local dev uses SQLite; production uses Postgres.

# Local (SQLite):
DATABASE_URL="file:./dev.db"
# Production (Postgres) example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ht?schema=public"

# Auth — REQUIRED. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Payments: "sandbox" (default, no keys) or "razorpay"
PAYMENT_PROVIDER="sandbox"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
